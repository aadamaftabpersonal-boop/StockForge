# Copy to .env and change every value. Never commit .env.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=stockforge

# Application connection (least-privilege user created by scripts/db-init.sh)
SF_DB_HOST=db
SF_DB_PORT=3306
SF_DB_USER=sf_app
SF_DB_PASSWORD=change-me-app
SF_DB_NAME=stockforge

# Optional: bearer token for GET /metrics (>=16 chars). Admin sessions also work.
SF_METRICS_TOKEN=
